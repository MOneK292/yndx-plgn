{
  "manifest_version": 3,
  "name": "Stats Button",
  "version": "2.0.0",
  "description": "Быстрые клавиши, подсчет стоимости задач, шаблоны сообщений и копирование объектов",
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://npro.maps.yandex.ru/*"
      ],
      "js": [
        "hotkeys.js",
        "support-message-buttons.js",
        "stats-enhancer.js",
        "address-copy-button.js"
      ],
      "run_at": "document_idle"
    }
  ]
}