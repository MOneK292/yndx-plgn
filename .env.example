# Пример файла с переменными окружения
# Скопируйте этот файл в .env и заполните своими значениями

# API endpoints (не изменяйте без необходимости)
API_URL=https://npro.maps.yandex.ru/api/v2/batch
METRICA_URL=https://mc.yandex.ru/watch/*

# Настройки производительности (в миллисекундах)
STATS_ENHANCER_THROTTLE=3000
ADDRESS_COPY_THROTTLE=1000
SUPPORT_BUTTONS_THROTTLE=2000

# Интервалы проверки (в миллисекундах)
ADDRESS_CHECK_INTERVAL=2500
CACHE_CLEAN_INTERVAL=300000

# Отладка (true/false)
DEBUG_MODE=false
VERBOSE_LOGGING=false

# Примечание: Этот файл не используется напрямую расширением
# Он служит документацией для разработчиков
